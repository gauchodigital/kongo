{
  "name": "kongo-cms",
  "version": "1.0.0",
  "private": true,
  "description": "Sitio Kongo con dashboard editorial",
  "main": "app.cjs",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"node --watch server/index.js\" \"vite --host 0.0.0.0\"",
    "build": "vite build",
    "start": "node app.cjs",
    "migrate": "node server/migrate.js",
    "seed": "node server/seed.js",
    "seed:generate": "node scripts/generate-seed.mjs",
    "check": "node --check server/index.js && node --check server/store.js && node --check server/routes.js",
    "test": "node --test tests/*.test.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^5.0.4",
    "bcryptjs": "^3.0.2",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "express-session": "^1.18.2",
    "helmet": "^8.1.0",
    "multer": "^2.0.2",
    "mysql2": "^3.15.1",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "sharp": "^0.35.4",
    "slugify": "^1.6.6",
    "vite": "^7.1.7",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
