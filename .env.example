NODE_ENV=development
PORT=3010
APP_URL=http://localhost:3010
SESSION_SECRET=replace-with-at-least-32-random-characters
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=kongo_staging
DB_USER=kongo_staging
DB_PASSWORD=
# Local development works with an in-memory seeded store when true.
USE_MEMORY_STORE=true
# Staging stays out of search engines unless this is true.
PUBLIC_INDEXING=false
# One-time bootstrap account. Remove these variables after the first seed.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-password
ADMIN_NAME=Administrador Kongo
